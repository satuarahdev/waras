# ==============================================================================
# WARAS - Sane WhatsApp Cloud API Gateway & Relay Wrapper (Rust)
# ==============================================================================

# Server Listening Port (Default: 3000 or 25335)
PORT=3000

# Meta / WhatsApp Cloud API Credentials
# Obtained from Meta for Developers (developers.facebook.com)
WHATSAPP_PHONE_NUMBER_ID=109876543210987
FACEBOOK_API_TOKEN=EAAG...YourPermanentOrTemporaryTokenHere
FACEBOOK_CLIENT_ID=your_facebook_app_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_client_secret

# Webhook Verification Token (set in Meta Webhook Configuration dashboard)
WEBHOOK_VERIFY_TOKEN=your_custom_secret_verify_token_here

# Target Webhook URL where incoming WhatsApp messages will be forwarded
# (Points to your backend logic service, e.g., Bantu Backend Rust / Python)
WEBHOOK_FORWARD_URL=https://your-backend-api.com/api/v1/webhook/whatsapp
